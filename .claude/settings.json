{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m unittest *)",
      "Bash(python3 -m unittest *)",
      "Bash(.venv/bin/python -m py_compile *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/py-syntax-check.sh",
            "timeout": 15,
            "statusMessage": "py_compile"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-gate.sh",
            "timeout": 300,
            "statusMessage": "unittest gate before commit"
          }
        ]
      }
    ]
  }
}
